# FORGE Configuration
# Configurazione backend Docker; il client usa il server nelle Impostazioni.
# Non committare credenziali. Il file .env resta locale.

# Il client usa FORGE pubblico senza configurazione.

# Docker — imposta credenziali uniche prima dell'avvio. Mai incorporate nell'app.
# Choose a PocketBase release >= 0.23.0, validate it before upgrading existing data.
# No latest image or automatic database upgrade.
PB_VERSION=
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
# Loopback: Nginx sullo stesso host. Per proxy separato usa l'IP LAN
# del server e limita via firewall l'accesso alla 8090 al solo proxy.
PB_BIND_ADDRESS=127.0.0.1
# PB_ENCRYPTION_KEY=

# Optional FCM worker: use the same random token in PocketBase and the worker.
FORGE_PUSH_WORKER_TOKEN=
