<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:Forge.Services"
             x:Class="Forge.Controls.MiniWorkoutBar"
             x:DataType="services:WorkoutSession"
             BindingContext="{StaticResource WorkoutSession}"
             IsVisible="{Binding ShowMiniBar}">
    <Border Margin="12,6" Padding="16,10" StrokeShape="RoundRectangle 16"
            Stroke="{DynamicResource ElectricBlue}" BackgroundColor="{DynamicResource SurfaceContainer}">
        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ResumeCommand}" /></Border.GestureRecognizers>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding MiniLabel}" MaxLines="1" LineBreakMode="TailTruncation" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                <Label Text="{Binding MiniRestLabel}" FontFamily="Lexend" FontSize="18" TextColor="{DynamicResource ElectricBlue}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Riprendi ↑" Command="{Binding ResumeCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource ElectricBlue}" Padding="4,0" />
        </Grid>
    </Border>
</ContentView>
