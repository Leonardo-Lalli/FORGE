<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:Forge.Services"
             x:Class="Forge.Controls.PlanSyncStatus" x:DataType="services:PlanService"
             BindingContext="{StaticResource PlanService}" IsVisible="{Binding HasSyncError}">
    <Border Padding="16" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource SurfaceContainerHigh}" Stroke="{DynamicResource Error}">
        <VerticalStackLayout Spacing="8">
            <Label Text="{Binding SyncError}" LineBreakMode="WordWrap" FontFamily="Inter" FontSize="13" TextColor="{DynamicResource OnSurface}" />
            <Button Text="Riprova sincronizzazione" Command="{Binding SyncPlansCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource ElectricBlue}" FontFamily="Lexend" />
        </VerticalStackLayout>
    </Border>
</ContentView>
