<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Forge.ViewModels"
    xmlns:controls="clr-namespace:Forge.Controls"
    xmlns:models="clr-namespace:Forge.Models"
    xmlns:services="clr-namespace:Forge.Services"
    x:Class="Forge.Views.ActiveWorkoutPage"
    x:Name="workoutPage"
    x:DataType="vm:ActiveWorkoutViewModel"
    Title="WORKOUT"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="{DynamicResource Surface}">
        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="8" Padding="16,12">
            <Button Text="✕" Command="{Binding MinimizeWorkoutCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource OnSurface}" FontSize="22" Padding="0" HeightRequest="44" />
            <VerticalStackLayout Grid.Column="1" Spacing="0">
                <Entry Text="{Binding PlanNameInput}" Placeholder="Workout Name" FontFamily="{AppThemeBinding Light=Inter, Dark=SpaceGrotesk}" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" PlaceholderColor="{DynamicResource TextSecondary}" BackgroundColor="Transparent" />
                <Label Text="{Binding ElapsedTime}" IsVisible="{Binding IsTimerRunning}" FontFamily="Lexend" FontSize="11" TextColor="{DynamicResource TextSecondary}" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="FINISH" Command="{Binding FinishOrSaveCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource ElectricBlue}" FontFamily="Lexend" FontAttributes="Bold" Padding="8,0">
                <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsCreating}" Value="True"><Setter Property="Text" Value="SALVA" /></DataTrigger></Button.Triggers>
            </Button>
        </Grid>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Exercises}" SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout Padding="20,0" Spacing="10">
                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsNotificationVisible}">
                        <Label Text="{Binding NotificationMessage}" TextColor="{DynamicResource OnSurface}" FontSize="12" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="✕" Command="{Binding DismissNotificationCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource OnSurface}" WidthRequest="36" />
                    </Grid>
                    <Editor Text="{Binding WorkoutNotes}" Placeholder="Note dell’allenamento" FontFamily="Inter" FontSize="13" HeightRequest="48" TextColor="{DynamicResource OnSurface}" PlaceholderColor="{DynamicResource TextSecondary}" BackgroundColor="Transparent" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Text="Scatta foto" Command="{Binding TakePhotoCommand}" BackgroundColor="{DynamicResource SurfaceContainer}" TextColor="{DynamicResource OnSurface}" CornerRadius="12" HeightRequest="40" FontSize="12" />
                        <Button Grid.Column="1" Text="Galleria" Command="{Binding PickPhotoCommand}" BackgroundColor="{DynamicResource SurfaceContainer}" TextColor="{DynamicResource OnSurface}" CornerRadius="12" HeightRequest="40" FontSize="12" />
                    </Grid>
                    <ScrollView Orientation="Horizontal" IsVisible="{Binding HasWorkoutPhotos}" HeightRequest="64">
                        <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding WorkoutPhotos}">
                            <BindableLayout.ItemTemplate><DataTemplate x:DataType="x:String">
                                <Border WidthRequest="60" HeightRequest="60" StrokeShape="RoundRectangle 10" Padding="0">
                                    <Image Source="{Binding ., Converter={StaticResource WorkoutPhotoConverter}}" Aspect="AspectFill" />
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference workoutPage}, Path=BindingContext.RemovePhotoCommand}" CommandParameter="{Binding .}" /></Border.GestureRecognizers>
                                </Border>
                            </DataTemplate></BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.EmptyView><Label Text="Aggiungi il primo esercizio" FontFamily="Inter" TextColor="{DynamicResource TextSecondary}" HorizontalTextAlignment="Center" Margin="20,36" /></CollectionView.EmptyView>
            <CollectionView.ItemTemplate><DataTemplate x:DataType="models:WorkoutExercise">
                <VerticalStackLayout Padding="20,24,20,8" Spacing="14">
                    <Label Text="{Binding Order, StringFormat='ESERCIZIO {0}'}" FontFamily="Lexend" CharacterSpacing="1" FontSize="10" TextColor="{DynamicResource ElectricBlue}" />
                    <Grid ColumnDefinitions="*,44,44" ColumnSpacing="4">
                        <Label Text="{Binding ExerciseName}" FontFamily="{AppThemeBinding Light=Inter, Dark=SpaceGrotesk}" FontSize="25" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" VerticalOptions="Center" MaxLines="2" LineBreakMode="TailTruncation">
                            <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference workoutPage}, Path=BindingContext.OpenExerciseDetailCommand}" CommandParameter="{Binding .}" /></Label.GestureRecognizers>
                        </Label>
                        <Border Grid.Column="1" BackgroundColor="Transparent" StrokeThickness="0" WidthRequest="44" HeightRequest="44" Padding="10">
                            <Path Data="M9,1 L15,1 M12,1 L12,5 M18,5 L20,3 M12,5 A8,8 0 1 1 11.99,5 M12,8 L12,13 L15,15" Stroke="{DynamicResource ElectricBlue}" StrokeThickness="2" />
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference workoutPage}, Path=BindingContext.ShowRestPickerCommand}" CommandParameter="{Binding .}" /></Border.GestureRecognizers>
                        </Border>
                        <Button Grid.Column="2" Text="⋮" FontSize="24" Padding="0" BackgroundColor="Transparent" TextColor="{DynamicResource OnSurface}" Command="{Binding Source={x:Reference workoutPage}, Path=BindingContext.ShowExerciseMenuCommand}" CommandParameter="{Binding .}" />
                    </Grid>
                    <Border BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="✦" TextColor="{DynamicResource ElectricBlue}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding ExecutionTip}" FontFamily="Inter" FontSize="13" TextColor="{DynamicResource TextSecondary}" MaxLines="3" LineBreakMode="TailTruncation" />
                        </Grid>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference workoutPage}, Path=BindingContext.OpenExerciseDetailCommand}" CommandParameter="{Binding .}" /></Border.GestureRecognizers>
                    </Border>
                    <Grid ColumnDefinitions="72,*" ColumnSpacing="12">
                        <Border WidthRequest="72" HeightRequest="72" Padding="0" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0">
                            <Image Source="{Binding ImageUrl}" Aspect="AspectFit" IsAnimationPlaying="True" />
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference workoutPage}, Path=BindingContext.OpenExerciseDetailCommand}" CommandParameter="{Binding .}" /></Border.GestureRecognizers>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding BodyPart}" FontFamily="Inter" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                            <Label Text="{Binding RestLabel}" FontFamily="Lexend" FontSize="13" TextColor="{DynamicResource ElectricBlue}" Padding="0,8">
                                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference workoutPage}, Path=BindingContext.ShowRestPickerCommand}" CommandParameter="{Binding .}" /></Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="26,*,*,*,40" ColumnSpacing="6">
                        <Label Text="SET" FontSize="9" TextColor="{DynamicResource TextSecondary}" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="1" Text="PREV" FontSize="9" TextColor="{DynamicResource TextSecondary}" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="2" Text="KG" FontSize="9" TextColor="{DynamicResource TextSecondary}" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="3" Text="REPS" FontSize="9" TextColor="{DynamicResource TextSecondary}" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="4" Text="✓" FontSize="11" TextColor="{DynamicResource TextSecondary}" HorizontalTextAlignment="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />
                    <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Sets}">
                        <BindableLayout.ItemTemplate><DataTemplate x:DataType="models:ExerciseSet">
                            <Grid ColumnDefinitions="26,*,*,*,40" ColumnSpacing="6" HeightRequest="52">
                                <Label Text="{Binding DisplayLabel}" FontFamily="Lexend" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" VerticalOptions="Center" HorizontalTextAlignment="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="warmup"><Setter Property="TextColor" Value="#F4B942" /></DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="drop"><Setter Property="TextColor" Value="#AF85FF" /></DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="failure"><Setter Property="TextColor" Value="#FF6B6B" /></DataTrigger>
                                    </Label.Triggers>
                                    <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference workoutPage}, Path=BindingContext.ShowSetKindCommand}" CommandParameter="{Binding .}" /></Label.GestureRecognizers>
                                </Label>
                                <Label Grid.Column="1" Text="{Binding PreviousText}" FontSize="10" TextColor="{DynamicResource TextSecondary}" HorizontalTextAlignment="Center" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                <Border Grid.Column="2" StrokeShape="RoundRectangle 8" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0" Padding="4,0">
                                    <Entry Text="{Binding WeightKg}" Keyboard="Numeric" HorizontalTextAlignment="Center" FontFamily="{AppThemeBinding Light=Inter, Dark=SpaceGrotesk}" FontSize="17" TextColor="{DynamicResource OnSurface}" BackgroundColor="Transparent">
                                        <Entry.Triggers><DataTrigger TargetType="Entry" Binding="{Binding IsSuggested}" Value="True"><Setter Property="TextColor" Value="{DynamicResource TextSecondary}" /></DataTrigger></Entry.Triggers>
                                    </Entry>
                                </Border>
                                <Border Grid.Column="3" StrokeShape="RoundRectangle 8" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0" Padding="4,0">
                                    <Entry Text="{Binding Reps}" Keyboard="Numeric" HorizontalTextAlignment="Center" FontFamily="{AppThemeBinding Light=Inter, Dark=SpaceGrotesk}" FontSize="17" TextColor="{DynamicResource OnSurface}" BackgroundColor="Transparent">
                                        <Entry.Triggers><DataTrigger TargetType="Entry" Binding="{Binding IsSuggested}" Value="True"><Setter Property="TextColor" Value="{DynamicResource TextSecondary}" /></DataTrigger></Entry.Triggers>
                                    </Entry>
                                </Border>
                                <Button Grid.Column="4" Text="✓" Command="{Binding Source={x:Reference workoutPage}, Path=BindingContext.CompleteSetCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="{DynamicResource Outline}" FontSize="20" Padding="0" CornerRadius="20">
                                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsCompleted}" Value="True"><Setter Property="TextColor" Value="{DynamicResource LimeGreen}" /></DataTrigger></Button.Triggers>
                                </Button>
                            </Grid>
                        </DataTemplate></BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="+ AGGIUNGI SERIE" Command="{Binding Source={x:Reference workoutPage}, Path=BindingContext.AddSetCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="{DynamicResource OnSurface}" FontFamily="Lexend" FontSize="11" HeightRequest="44" />
                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceContainer}" Padding="10,2">
                        <Entry Text="{Binding Notes}" Placeholder="Note per questo esercizio" FontFamily="Inter" FontSize="12" TextColor="{DynamicResource OnSurface}" PlaceholderColor="{DynamicResource TextSecondary}" BackgroundColor="Transparent" />
                    </Border>
                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" Margin="0,12,0,0" />
                </VerticalStackLayout>
            </DataTemplate></CollectionView.ItemTemplate>
            <CollectionView.Footer><Button Text="+ AGGIUNGI ESERCIZIO" Command="{Binding AddExerciseCommand}" Margin="20,16,20,24" HeightRequest="52" CornerRadius="14" BackgroundColor="{DynamicResource ElectricBlue}" TextColor="{DynamicResource OnPrimary}" FontFamily="Lexend" /></CollectionView.Footer>
        </CollectionView>
        <Border Grid.Row="2" IsVisible="{Binding IsRestTimerActive}" Margin="16,8,16,16" StrokeShape="RoundRectangle 16" Padding="16" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={DynamicResource ElectricBlue}, Dark={DynamicResource SurfaceContainer}}">
            <Grid ColumnDefinitions="Auto,*,48,64" ColumnSpacing="10">
                <Path Data="M9,1 L15,1 M12,1 L12,5 M18,5 L20,3 M12,5 A8,8 0 1 1 11.99,5 M12,8 L12,13 L15,15" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" StrokeThickness="2" Stroke="{AppThemeBinding Light=White, Dark={DynamicResource ElectricBlue}}" />
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="RECUPERO" FontFamily="Lexend" FontSize="9" CharacterSpacing="1" TextColor="{AppThemeBinding Light=White, Dark={DynamicResource TextSecondary}}" />
                    <Label Text="{Binding RestTimerText}" FontFamily="{AppThemeBinding Light=Inter, Dark=SpaceGrotesk}" FontSize="28" FontAttributes="Bold" TextColor="{AppThemeBinding Light=White, Dark={DynamicResource OnSurface}}" />
                </VerticalStackLayout>
                <Button Grid.Column="2" Text="{Binding PauseTimerLabel}" Command="{Binding PauseRestTimerCommand}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=White, Dark={DynamicResource OnSurface}}" FontSize="20" Padding="0" />
                <Button Grid.Column="3" Text="SALTA" Command="{Binding SkipRestTimerCommand}" BackgroundColor="{AppThemeBinding Light=White, Dark={DynamicResource SurfaceContainerHigh}}" TextColor="{DynamicResource ElectricBlue}" FontFamily="Lexend" FontSize="10" Padding="8,0" CornerRadius="20" />
            </Grid>
        </Border>
        <!-- Search Exercise Overlay -->
        <Grid Grid.RowSpan="3" IsVisible="{Binding IsSearchVisible}"
              BackgroundColor="{DynamicResource Surface}" Padding="20,16" ZIndex="20"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">

            <!-- Search Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <Border Grid.Column="0" BackgroundColor="{DynamicResource SurfaceContainer}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" Padding="14,4">
                    <Entry Placeholder="Cerca esercizio..."
                           Text="{Binding SearchQuery}"
                           FontFamily="Inter" FontSize="16"
                           TextColor="{DynamicResource OnSurface}"
                           PlaceholderColor="{DynamicResource Outline}"
                           BackgroundColor="Transparent"
                           ReturnType="Search"
                           ReturnCommand="{Binding SearchExercisesCommand}" />
                </Border>
                <Button Grid.Column="1" Text="SEARCH" FontFamily="Lexend" FontSize="12" FontAttributes="Bold"
                        BackgroundColor="{DynamicResource Primary}" TextColor="{DynamicResource OnPrimary}"
                        HeightRequest="44" CornerRadius="10" Margin="8,0,0,0" Padding="12,0"
                        Command="{Binding SearchExercisesCommand}" />
            </Grid>

            <!-- Filter Chips: Muscle Groups -->
            <Label Grid.Row="1" Text="MUSCLE GROUP" FontFamily="Lexend" FontSize="9" FontAttributes="Bold"
                   TextColor="{DynamicResource TextSecondary}" CharacterSpacing="0.6" Margin="0,8,0,0" />
            <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" HeightRequest="36">
                <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding MuscleFilters}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilterChip">
                            <Border StrokeShape="RoundRectangle 14"
                                    Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1"
                                    Padding="12,5" HeightRequest="30"
                                    BackgroundColor="Transparent">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                                        <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference workoutPage}, Path=BindingContext.SelectMuscleFilterCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Label}" FontFamily="Inter" FontSize="12"
                                       TextColor="{DynamicResource OnSurface}" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Filter Chips: Equipment -->
            <Label Grid.Row="3" Text="EQUIPMENT" FontFamily="Lexend" FontSize="9" FontAttributes="Bold"
                   TextColor="{DynamicResource TextSecondary}" CharacterSpacing="0.6" Margin="0,4,0,0" />
            <ScrollView Grid.Row="4" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" HeightRequest="36">
                <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding EquipmentFilters}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilterChip">
                            <Border StrokeShape="RoundRectangle 14"
                                    Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1"
                                    Padding="12,5" HeightRequest="30"
                                    BackgroundColor="Transparent">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                                        <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference workoutPage}, Path=BindingContext.SelectEquipmentFilterCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Label}" FontFamily="Inter" FontSize="12"
                                       TextColor="{DynamicResource OnSurface}" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Loading + Error -->
            <VerticalStackLayout Grid.Row="5" Spacing="4">
                <ActivityIndicator IsRunning="{Binding IsSearchingApi}" IsVisible="{Binding IsSearchingApi}"
                                   HorizontalOptions="Center" Color="{DynamicResource Primary}" />
                <Label Text="Caricamento catalogo: la prima apertura può richiedere qualche minuto."
                       IsVisible="{Binding IsSearchingApi}" FontSize="11" TextColor="{DynamicResource TextSecondary}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding SearchResults.Count, StringFormat='{0} esercizi trovati'}"
                       IsVisible="{Binding IsSearchingApi, Converter={StaticResource InverseBoolConverter}}"
                       FontSize="11" TextColor="{DynamicResource TextSecondary}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding SearchError}" IsVisible="{Binding HasSearchError}"
                       FontFamily="Inter" FontSize="13" TextColor="{DynamicResource Error}"
                       HorizontalTextAlignment="Center" Margin="0,2" />
            </VerticalStackLayout>

            <!-- Scrollable Results -->
            <CollectionView Grid.Row="6" ItemsSource="{Binding SearchResults}"
                            IsVisible="{Binding IsSearchingApi, Converter={StaticResource InverseBoolConverter}}"
                            VerticalScrollBarVisibility="Default">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExerciseSearchResult">
                        <Border BackgroundColor="{DynamicResource SurfaceContainer}"
                                StrokeShape="RoundRectangle 10" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1"
                                Padding="12" Margin="0,4">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference workoutPage}, Path=BindingContext.SelectExerciseCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="80,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                                <Border Grid.Column="0" Grid.RowSpan="2"
                                        BackgroundColor="{DynamicResource SurfaceContainerHighest}"
                                        StrokeShape="RoundRectangle 8" WidthRequest="80" HeightRequest="80">
                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFill"
                                           WidthRequest="80" HeightRequest="80" />
                                </Border>
                                <Label Grid.Column="1" Grid.Row="0" Text="{Binding Name}"
                                       FontFamily="{AppThemeBinding Light=Inter, Dark=SpaceGrotesk}" FontSize="16" FontAttributes="Bold"
                                       TextColor="{DynamicResource OnSurface}" LineBreakMode="TailTruncation"
                                       VerticalOptions="End" />
                                <Label Grid.Column="1" Grid.Row="1" Text="{Binding BodyPart}"
                                       FontFamily="Inter" FontSize="13"
                                       TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Start" Margin="0,2,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Close button -->
            <Button Grid.Row="7" Text="✕ CLOSE" FontFamily="Lexend" FontSize="13" FontAttributes="Bold"
                    BackgroundColor="{DynamicResource SurfaceContainerHigh}"
                    TextColor="{DynamicResource OnSurfaceVariant}"
                    HeightRequest="44" CornerRadius="10"
                    Command="{Binding CloseSearchCommand}" />
        </Grid>

        <!-- Exercise Detail Overlay -->
        <Border Grid.RowSpan="3" IsVisible="{Binding IsExerciseDetailVisible}"
                BackgroundColor="{DynamicResource Surface}" Padding="0">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="20,16"
                      BackgroundColor="{DynamicResource Surface}">
                    <Border Grid.Column="0" BackgroundColor="{DynamicResource SurfaceContainer}"
                            StrokeShape="RoundRectangle 999" WidthRequest="36" HeightRequest="36" Padding="0">
                        <Label Text="✕" FontSize="14" TextColor="{DynamicResource OnSurface}"
                               HorizontalOptions="Center" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseExerciseDetailCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                    <Label Grid.Column="1" Text="{Binding SelectedExercise.ExerciseName}"
                           FontFamily="{AppThemeBinding Light=Inter, Dark=SpaceGrotesk}" FontSize="18" FontAttributes="Bold"
                           TextColor="{DynamicResource OnSurface}"
                           HorizontalOptions="Center" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                    <BoxView Grid.Column="2" WidthRequest="36" Color="Transparent" />
                </Grid>

                <ScrollView Grid.Row="1" Padding="20,0,20,20">
                    <VerticalStackLayout Spacing="20">
                        <Border BackgroundColor="{DynamicResource SurfaceContainerLowest}"
                                StrokeShape="RoundRectangle 16" Stroke="{DynamicResource OutlineVariant}"
                                StrokeThickness="1" Padding="0" HeightRequest="240">
                            <Image Source="{Binding SelectedExercise.GifUrl}" Aspect="AspectFit" IsAnimationPlaying="True" />
                        </Border>

                        <Grid ColumnDefinitions="*,Auto,*,Auto,*" ColumnSpacing="0">
                            <Border Grid.Column="0" BackgroundColor="{DynamicResource SurfaceContainer}"
                                    StrokeShape="RoundRectangle 10" Padding="12,8" Margin="0,0,4,0">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                    <Label Text="MUSCLE" FontFamily="Lexend" FontSize="9" FontAttributes="Bold"
                                           TextColor="{DynamicResource TextSecondary}" CharacterSpacing="0.6"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding SelectedExercise.BodyPart}"
                                           FontFamily="{AppThemeBinding Light=Inter, Dark=SpaceGrotesk}" FontSize="13" FontAttributes="Bold"
                                           TextColor="{DynamicResource Primary}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" BackgroundColor="{DynamicResource SurfaceContainer}"
                                    StrokeShape="RoundRectangle 10" Padding="12,8" Margin="4,0">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                    <Label Text="EQUIP" FontFamily="Lexend" FontSize="9" FontAttributes="Bold"
                                           TextColor="{DynamicResource TextSecondary}" CharacterSpacing="0.6"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding SelectedExercise.Equipment}"
                                           FontFamily="{AppThemeBinding Light=Inter, Dark=SpaceGrotesk}" FontSize="13" FontAttributes="Bold"
                                           TextColor="{DynamicResource Primary}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="4" BackgroundColor="{DynamicResource SurfaceContainer}"
                                    StrokeShape="RoundRectangle 10" Padding="12,8" Margin="4,0,0,0">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                    <Label Text="SETS" FontFamily="Lexend" FontSize="9" FontAttributes="Bold"
                                           TextColor="{DynamicResource TextSecondary}" CharacterSpacing="0.6"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding SelectedExercise.Sets.Count}"
                                           FontFamily="{AppThemeBinding Light=Inter, Dark=SpaceGrotesk}" FontSize="13" FontAttributes="Bold"
                                           TextColor="{DynamicResource Primary}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Label Text="Progressione" FontFamily="Lexend" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                        <Button Text="{Binding SelectedProgressMetric}" Command="{Binding ShowProgressMetricMenuCommand}" TextColor="{DynamicResource OnSurface}" BackgroundColor="{DynamicResource SurfaceContainer}" CornerRadius="12" />
                        <Label Text="Completa un allenamento con questo esercizio per vedere la progressione." IsVisible="{Binding HasExerciseProgress, Converter={StaticResource InverseBoolConverter}}" FontFamily="Inter" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                        <ScrollView Orientation="Horizontal" IsVisible="{Binding HasExerciseProgress}" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding ExerciseProgressPoints}">
                                <BindableLayout.ItemTemplate><DataTemplate x:DataType="services:ExerciseProgressPoint">
                                    <Grid WidthRequest="54" HeightRequest="164" RowDefinitions="20,120,24">
                                        <Label Text="{Binding Value, StringFormat='{0:0.#}'}" FontFamily="Inter" FontSize="10" HorizontalTextAlignment="Center" TextColor="{DynamicResource OnSurface}" />
                                        <Border Grid.Row="1" WidthRequest="28" HeightRequest="{Binding Height}" VerticalOptions="End" HorizontalOptions="Center" StrokeShape="RoundRectangle 6" StrokeThickness="0" BackgroundColor="{DynamicResource ElectricBlue}" />
                                        <Label Grid.Row="2" Text="{Binding Date}" FontFamily="Inter" FontSize="10" HorizontalTextAlignment="Center" TextColor="{DynamicResource TextSecondary}" />
                                    </Grid>
                                </DataTemplate></BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>

                        <Label Text="INSTRUCTIONS" FontFamily="Lexend" FontSize="10" FontAttributes="Bold"
                               TextColor="{DynamicResource TextSecondary}" CharacterSpacing="0.8" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedExercise.Instructions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="0,4">
                                        <Label Grid.Column="0" Text="•" FontSize="14" TextColor="{DynamicResource Primary}" VerticalOptions="Start" />
                                        <Label Grid.Column="1" Text="{Binding .}" FontFamily="Inter" FontSize="14"
                                               TextColor="{DynamicResource OnSurface}" LineBreakMode="WordWrap" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>

                <Border Grid.Row="2" Margin="16,8,16,16" BackgroundColor="{DynamicResource SurfaceContainerHigh}"
                        Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                        Padding="0" HeightRequest="52">
                    <Label Text="✕ CLOSE DETAILS" FontFamily="Lexend" FontSize="13" FontAttributes="Bold"
                           TextColor="{DynamicResource OnSurfaceVariant}"
                           HorizontalOptions="Center" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseExerciseDetailCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
            </Grid>
        </Border>


        <Grid Grid.RowSpan="3" ZIndex="40" IsVisible="{Binding IsProgressMetricMenuVisible}" BackgroundColor="#99000000" Padding="20">
            <Border VerticalOptions="End" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeShape="RoundRectangle 24" Padding="20" StrokeThickness="0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Progressione esercizio" FontSize="20" FontFamily="{AppThemeBinding Light=Inter, Dark=SpaceGrotesk}" TextColor="{DynamicResource OnSurface}" />
                    <Button Text="Peso massimo (kg)" Command="{Binding SelectProgressMetricCommand}" CommandParameter="0" BackgroundColor="Transparent" TextColor="{DynamicResource OnSurface}" />
                    <Button Text="Serie completate" Command="{Binding SelectProgressMetricCommand}" CommandParameter="1" BackgroundColor="Transparent" TextColor="{DynamicResource OnSurface}" />
                    <Button Text="Ripetizioni totali" Command="{Binding SelectProgressMetricCommand}" CommandParameter="2" BackgroundColor="Transparent" TextColor="{DynamicResource OnSurface}" />
                    <Button Text="Volume totale (kg)" Command="{Binding SelectProgressMetricCommand}" CommandParameter="3" BackgroundColor="Transparent" TextColor="{DynamicResource OnSurface}" />
                    <Button Text="Chiudi" Command="{Binding CloseProgressMetricMenuCommand}" BackgroundColor="{DynamicResource SurfaceContainerHigh}" TextColor="{DynamicResource OnSurface}" CornerRadius="12" />
                </VerticalStackLayout>
            </Border>
        </Grid>
        <Grid Grid.RowSpan="3" ZIndex="30" IsVisible="{Binding IsExerciseMenuVisible}" BackgroundColor="#99000000" Padding="20">
            <Border VerticalOptions="End" StrokeShape="RoundRectangle 24" BackgroundColor="{DynamicResource SurfaceContainer}" Padding="20" StrokeThickness="0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding SelectedExercise.ExerciseName}" TextColor="{DynamicResource OnSurface}" FontFamily="{AppThemeBinding Light=Inter, Dark=SpaceGrotesk}" FontSize="20" Margin="0,0,0,8" />
                    <Button Text="Sposta prima" Command="{Binding MenuMoveUpCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource OnSurface}" />
                    <Button Text="Sposta dopo" Command="{Binding MenuMoveDownCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource OnSurface}" />
                    <Button Text="Sostituisci esercizio" Command="{Binding MenuReplaceCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource ElectricBlue}" />
                    <Button Text="Elimina dall’allenamento" Command="{Binding MenuRemoveCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource Error}" />
                    <Button Text="Chiudi" Command="{Binding CloseExerciseMenuCommand}" BackgroundColor="{DynamicResource SurfaceContainerHigh}" TextColor="{DynamicResource OnSurface}" CornerRadius="12" />
                </VerticalStackLayout>
            </Border>
        </Grid>
        <Grid Grid.RowSpan="3" ZIndex="30" IsVisible="{Binding IsRestPickerVisible}" BackgroundColor="#99000000" Padding="20">
            <Border VerticalOptions="End" MaximumHeightRequest="600" StrokeShape="RoundRectangle 24" BackgroundColor="{DynamicResource SurfaceContainer}" Padding="24" StrokeThickness="0">
                <ScrollView VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Tempo di recupero" FontFamily="{AppThemeBinding Light=Inter, Dark=SpaceGrotesk}" FontSize="24" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                    <Label Text="{Binding SelectedExercise.ExerciseName}" FontFamily="Inter" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                    <Grid ColumnDefinitions="*,*"><Label Text="MINUTI" HorizontalTextAlignment="Center" FontSize="10" TextColor="{DynamicResource TextSecondary}" /><Label Grid.Column="1" Text="SECONDI" HorizontalTextAlignment="Center" FontSize="10" TextColor="{DynamicResource TextSecondary}" /></Grid>
                    <controls:RestDurationPicker Seconds="{Binding RestPickerSeconds}" TextColor="{DynamicResource ElectricBlue}" HeightRequest="140" />
                    <Button Text="Salva recupero" Command="{Binding SaveRestPickerCommand}" BackgroundColor="{DynamicResource ElectricBlue}" TextColor="{DynamicResource OnPrimary}" CornerRadius="12" />
                    <Button Text="Avvia timer" Command="{Binding StartPickedRestCommand}" IsVisible="{Binding IsCreating, Converter={StaticResource InverseBoolConverter}}" BackgroundColor="{DynamicResource SurfaceContainerHigh}" TextColor="{DynamicResource OnSurface}" CornerRadius="12" />
                    <Button Text="Suono e vibrazione del recupero" Command="{Binding RestSoundSettingsCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource ElectricBlue}" FontSize="11" />
                    <Button Text="Abilita allarmi precisi in background" Command="{Binding EnableExactRestCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource ElectricBlue}" FontSize="11" />
                    <Button Text="Annulla" Command="{Binding CloseRestPickerCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource OnSurface}" />
                </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
        <Grid Grid.RowSpan="3" ZIndex="50" IsVisible="{Binding IsPlanUpdateVisible}" BackgroundColor="#99000000" Padding="20">
            <Border VerticalOptions="Center" StrokeShape="RoundRectangle 24" BackgroundColor="{DynamicResource SurfaceContainer}" Padding="24" StrokeThickness="0">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Aggiornare la scheda?" FontFamily="{AppThemeBinding Light=Inter, Dark=SpaceGrotesk}" FontSize="23" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                    <Label Text="Hai modificato questa sessione. Vuoi salvare nella scheda nome, esercizi, ordine, serie e recuperi, oppure mantenere la versione originale? Le note vengono salvate automaticamente. L’allenamento verrà salvato in entrambi i casi." FontFamily="Inter" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                    <Button Text="Aggiorna scheda e termina" Command="{Binding UpdatePlanAndFinishCommand}" BackgroundColor="{DynamicResource ElectricBlue}" TextColor="{DynamicResource OnPrimary}" CornerRadius="12" />
                    <Button Text="Mantieni originale e termina" Command="{Binding KeepPlanAndFinishCommand}" BackgroundColor="{DynamicResource SurfaceContainerHigh}" TextColor="{DynamicResource OnSurface}" CornerRadius="12" />
                    <Button Text="Torna all’allenamento" Command="{Binding CancelPlanUpdateCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource TextSecondary}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
        <Grid Grid.RowSpan="3" ZIndex="50" IsVisible="{Binding IsSetKindVisible}" BackgroundColor="#99000000" Padding="20">
            <Border VerticalOptions="End" StrokeShape="RoundRectangle 24" BackgroundColor="{DynamicResource SurfaceContainer}" Padding="20" StrokeThickness="0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Tipo di serie" FontFamily="{AppThemeBinding Light=Inter, Dark=SpaceGrotesk}" FontSize="23" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                    <Button Text="Serie normale · numero" Command="{Binding SelectSetKindCommand}" CommandParameter="normal" BackgroundColor="Transparent" TextColor="{DynamicResource OnSurface}" />
                    <Button Text="W · Warm-up" Command="{Binding SelectSetKindCommand}" CommandParameter="warmup" BackgroundColor="Transparent" TextColor="#F4B942" />
                    <Button Text="D · Drop set" Command="{Binding SelectSetKindCommand}" CommandParameter="drop" BackgroundColor="Transparent" TextColor="#AF85FF" />
                    <Button Text="F · Cedimento" Command="{Binding SelectSetKindCommand}" CommandParameter="failure" BackgroundColor="Transparent" TextColor="#FF6B6B" />
                    <Button Text="Chiudi" Command="{Binding CloseSetKindCommand}" BackgroundColor="{DynamicResource SurfaceContainerHigh}" TextColor="{DynamicResource OnSurface}" CornerRadius="12" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
