<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:Forge.ViewModels" x:Class="Forge.Views.LoginPage" x:DataType="vm:LoginViewModel" Shell.NavBarIsVisible="False" BackgroundColor="{AppThemeBinding Light=#F8F9FF, Dark=#111818}">
    <ScrollView>
        <VerticalStackLayout Padding="24,64,24,32" Spacing="32" MaximumWidthRequest="460" HorizontalOptions="Center">
            <VerticalStackLayout Spacing="4">
                <Label Text="FORGE." FontFamily="SpaceGrotesk" FontSize="56" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=#0052FF, Dark=#00D9ED}" />
                <Label Text="ELITE TERMINAL" FontFamily="Inter" FontSize="12" CharacterSpacing="2" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=#737688, Dark=#89999B}" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="12">
                <Label Text="System Access" FontFamily="SpaceGrotesk" FontSize="32" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=#0D1C2F, Dark=#E5E5E5}" />
                <Label Text="Accedi per iniziare il tuo allenamento." FontFamily="Inter" FontSize="15" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=#434656, Dark=#B6C7C9}" IsVisible="{Binding IsRegistering, Converter={StaticResource InverseBoolConverter}}" />
                <Label Text="Crea la tua identità atleta." FontFamily="Inter" FontSize="15" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=#434656, Dark=#B6C7C9}" IsVisible="{Binding IsRegistering}" />
            </VerticalStackLayout>
            <Border Padding="16,24" StrokeShape="RoundRectangle 12" Stroke="{AppThemeBinding Light=#E3E5EE, Dark=#333A3B}" BackgroundColor="{AppThemeBinding Light=White, Dark=#0D0D0D}">
                <VerticalStackLayout Spacing="16" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsRegistering}">
                        <Label Text="NOME ATLETA" FontFamily="Inter" FontSize="12" CharacterSpacing="1" TextColor="{AppThemeBinding Light=#737688, Dark=#89999B}" />
                        <Entry Text="{Binding Name}" Placeholder="Il tuo nome" HeightRequest="52" FontFamily="Inter" TextColor="{AppThemeBinding Light=#0D1C2F, Dark=#E5E5E5}" BackgroundColor="{AppThemeBinding Light=#EFF4FF, Dark=#333333}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="IDENTIFIER / EMAIL" FontFamily="Inter" FontSize="12" CharacterSpacing="1" TextColor="{AppThemeBinding Light=#737688, Dark=#89999B}" />
                        <Entry Text="{Binding Email}" Placeholder="user@forge-elite.com" Keyboard="Email" IsTextPredictionEnabled="False" HeightRequest="52" FontFamily="Inter" TextColor="{AppThemeBinding Light=#0D1C2F, Dark=#E5E5E5}" PlaceholderColor="#89999B" BackgroundColor="{AppThemeBinding Light=#EFF4FF, Dark=#333333}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="PASSCODE" FontFamily="Inter" FontSize="12" CharacterSpacing="1" TextColor="{AppThemeBinding Light=#737688, Dark=#89999B}" />
                        <Entry Text="{Binding Password}" Placeholder="Password" IsPassword="True" HeightRequest="52" FontFamily="Inter" TextColor="{AppThemeBinding Light=#0D1C2F, Dark=#E5E5E5}" PlaceholderColor="#89999B" BackgroundColor="{AppThemeBinding Light=#EFF4FF, Dark=#333333}" />
                    </VerticalStackLayout>
                    <Entry Text="{Binding PasswordConfirm}" Placeholder="Conferma password" IsPassword="True" IsVisible="{Binding IsRegistering}" HeightRequest="52" FontFamily="Inter" TextColor="{AppThemeBinding Light=#0D1C2F, Dark=#E5E5E5}" BackgroundColor="{AppThemeBinding Light=#EFF4FF, Dark=#333333}" />
                    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{DynamicResource Error}" FontSize="13" />
                    <Button Text="ENTRA →" Command="{Binding LoginCommand}" IsVisible="{Binding IsRegistering, Converter={StaticResource InverseBoolConverter}}" HeightRequest="56" CornerRadius="8" FontFamily="SpaceGrotesk" FontSize="22" BackgroundColor="{AppThemeBinding Light=#0052FF, Dark=#00D9ED}" TextColor="{AppThemeBinding Light=White, Dark=Black}" />
                    <Button Text="CREA ACCOUNT →" Command="{Binding RegisterCommand}" IsVisible="{Binding IsRegistering}" HeightRequest="56" CornerRadius="8" FontFamily="SpaceGrotesk" FontSize="20" BackgroundColor="{AppThemeBinding Light=#0052FF, Dark=#00D9ED}" TextColor="{AppThemeBinding Light=White, Dark=Black}" />
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E3E5EE, Dark=#333A3B}" Margin="0,8" />
                    <Button Text="Nuovo su FORGE? Crea account" Command="{Binding ToggleModeCommand}" IsVisible="{Binding IsRegistering, Converter={StaticResource InverseBoolConverter}}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#0052FF, Dark=#00D9ED}" />
                    <Button Text="Hai già un account? Accedi" Command="{Binding ToggleModeCommand}" IsVisible="{Binding IsRegistering}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#0052FF, Dark=#00D9ED}" />
                </VerticalStackLayout>
            </Border>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{AppThemeBinding Light=#0052FF, Dark=#00D9ED}" />
            <Button Text="Configura server · pubblico o personale" Command="{Binding OpenServerConfigCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#0052FF, Dark=#00D9ED}" FontFamily="Inter" FontSize="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
