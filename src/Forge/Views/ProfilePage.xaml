<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Forge.ViewModels"
    x:Name="profilePage"
    x:Class="Forge.Views.ProfilePage"
    x:DataType="vm:ProfileViewModel"
    Title="Profile"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" BackgroundColor="{DynamicResource Surface}">

        <!-- Header — mockup style -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto"
              Padding="24,16" BackgroundColor="{DynamicResource Surface}">
            <Border Grid.Column="0" BackgroundColor="{DynamicResource SurfaceContainer}"
                    StrokeShape="RoundRectangle 999" WidthRequest="40" HeightRequest="40" Padding="0"
                    Stroke="{DynamicResource OutlineVariant}" StrokeThickness="0.5">
                <Label Text="←" FontSize="18" TextColor="{DynamicResource OnSurface}"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>
            <Label Grid.Column="1" Text="PROFILE"
                   FontFamily="OpenSansSemibold" FontSize="18" FontAttributes="Bold"
                   TextColor="{DynamicResource Primary}"
                   HorizontalOptions="Center" VerticalOptions="Center"
                   CharacterSpacing="-1" />
            <BoxView Grid.Column="2" WidthRequest="40" Color="Transparent" />
            <!-- Edit pencil -->
            <Border Grid.Column="2" BackgroundColor="{DynamicResource SurfaceContainer}"
                    StrokeShape="RoundRectangle 999" WidthRequest="40" HeightRequest="40" Padding="0"
                    Stroke="{DynamicResource OutlineVariant}" StrokeThickness="0.5"
                    IsVisible="{Binding IsOwnProfile}">
                <Image Source="edit_profile.jpg" WidthRequest="22" HeightRequest="22"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding EditProfileCommand}" />
                    </Image.GestureRecognizers>
                </Image>
            </Border>
        </Grid>

        <ScrollView Grid.Row="1" Padding="24,8,24,100">
            <VerticalStackLayout Spacing="48">

                <!-- Profile Hero — centered avatar, name, tier -->
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    <!-- Avatar — image from PocketBase, fallback to initials -->
                    <Border BackgroundColor="{DynamicResource SurfaceContainerHigh}"
                            StrokeShape="RoundRectangle 64"
                            Stroke="{DynamicResource Surface}" StrokeThickness="4"
                            WidthRequest="128" HeightRequest="128" Padding="0"
                            HorizontalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeAvatarCommand}" />
                        </Border.GestureRecognizers>
                        <Grid><Image Source="{Binding AvatarSource}" Aspect="AspectFill"
                                WidthRequest="128" HeightRequest="128"
                                IsVisible="{Binding HasAvatar}" />
<Label Text="{Binding AvatarInitials}"
                               FontFamily="OpenSansSemibold" FontSize="40"
                               TextColor="{DynamicResource OnSurface}"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               IsVisible="{Binding HasAvatar, Converter={StaticResource InverseBoolConverter}}" /></Grid>
                    </Border>

                    <!-- Name -->
                    <Label Text="{Binding Username}"
                           FontFamily="OpenSansSemibold" FontSize="28" FontAttributes="Bold"
                           TextColor="{DynamicResource OnSurface}"
                           HorizontalTextAlignment="Center" />

                    <!-- Tier with dot -->
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Border BackgroundColor="{DynamicResource SecondaryContainer}"
                                StrokeShape="RoundRectangle 3"
                                WidthRequest="8" HeightRequest="8" Padding="0"
                                VerticalOptions="Center" />
                        <Label Text="{Binding Tier}"
                               FontFamily="OpenSansRegular" FontSize="18"
                               TextColor="{DynamicResource OnSurfaceVariant}" />
                    </HorizontalStackLayout>

                    <!-- Bio -->
                    <Label Text="{Binding Bio}"
                           FontFamily="OpenSansRegular" FontSize="14"
                           TextColor="{DynamicResource TextSecondary}"
                           HorizontalTextAlignment="Center" />
                    <Button Text="{Binding ProfileFollowLabel}" Command="{Binding FollowProfileCommand}"
                            IsVisible="{Binding IsOwnProfile, Converter={StaticResource InverseBoolConverter}}"
                            FontFamily="Lexend" FontAttributes="Bold" CornerRadius="16" HeightRequest="48" MinimumWidthRequest="160"
                            BackgroundColor="{DynamicResource Primary}" TextColor="{DynamicResource OnPrimary}" />
                </VerticalStackLayout>

                <Border BackgroundColor="{DynamicResource SurfaceContainer}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="0" IsVisible="{Binding CanViewConnections}">
                    <Grid ColumnDefinitions="*,1,*" Padding="0,16">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="4" Padding="12,0" SemanticProperties.Description="Apri follower">
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowFollowersCommand}" /></Grid.GestureRecognizers>
                            <Label Text="{Binding FollowersCount}" FontFamily="{AppThemeBinding Light=Inter, Dark=SpaceGrotesk}" FontSize="26" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{DynamicResource ElectricBlue}" />
                            <Label Grid.Row="1" Text="Follower ›" FontFamily="Inter" FontSize="12" HorizontalTextAlignment="Center" TextColor="{DynamicResource TextSecondary}" />
                        </Grid>
                        <BoxView Grid.Column="1" Color="{DynamicResource OutlineVariant}" Margin="0,4" />
                        <Grid Grid.Column="2" RowDefinitions="Auto,Auto" RowSpacing="4" Padding="12,0" SemanticProperties.Description="Apri seguiti">
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowFollowingCommand}" /></Grid.GestureRecognizers>
                            <Label Text="{Binding FollowingCount}" FontFamily="{AppThemeBinding Light=Inter, Dark=SpaceGrotesk}" FontSize="26" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{DynamicResource ElectricBlue}" />
                            <Label Grid.Row="1" Text="Seguiti ›" FontFamily="Inter" FontSize="12" HorizontalTextAlignment="Center" TextColor="{DynamicResource TextSecondary}" />
                        </Grid>
                    </Grid>
                </Border>
                <Label Text="Follower e seguiti sono privati." IsVisible="{Binding CanViewConnections, Converter={StaticResource InverseBoolConverter}}"
                       FontFamily="Inter" HorizontalTextAlignment="Center" TextColor="{DynamicResource TextSecondary}" />
                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{DynamicResource Error}" />
                <!-- Stats Grid 2x2 -->
                <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,16,Auto">
                    <!-- Total Workouts -->
                    <Border Grid.Row="0" Grid.Column="0"
                            BackgroundColor="{DynamicResource SurfaceContainerLowest}"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1"
                            Padding="20">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="{Binding TotalWorkouts}"
                                   FontFamily="OpenSansSemibold" FontSize="40" FontAttributes="Bold"
                                   TextColor="{DynamicResource Primary}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="TOTAL WORKOUTS"
                                   FontFamily="OpenSansSemibold" FontSize="11"
                                   TextColor="{DynamicResource OnSurfaceVariant}"
                                   CharacterSpacing="1"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Total Volume -->
                    <Border Grid.Row="0" Grid.Column="2"
                            BackgroundColor="{DynamicResource SurfaceContainerLowest}"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1"
                            Padding="20">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="{Binding TotalVolume}"
                                   FontFamily="OpenSansSemibold" FontSize="28" FontAttributes="Bold"
                                   TextColor="{DynamicResource LimeGreen}"
                                   HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                            <Label Text="TOTAL VOLUME"
                                   FontFamily="OpenSansSemibold" FontSize="11"
                                   TextColor="{DynamicResource OnSurfaceVariant}"
                                   CharacterSpacing="1"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Streak -->
                    <Border Grid.Row="2" Grid.Column="0"
                            BackgroundColor="{DynamicResource SurfaceContainerLowest}"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1"
                            Padding="20">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="{Binding StreakDays}"
                                   FontFamily="OpenSansSemibold" FontSize="40" FontAttributes="Bold"
                                   TextColor="{DynamicResource Primary}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding StreakLabel}"
                                   FontFamily="OpenSansSemibold" FontSize="11"
                                   TextColor="{DynamicResource OnSurfaceVariant}"
                                   CharacterSpacing="1"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Likes Received -->
                    <Border Grid.Row="2" Grid.Column="2"
                            BackgroundColor="{DynamicResource SurfaceContainerLowest}"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1"
                            Padding="20">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="{Binding TotalLikesReceived}"
                                   FontFamily="OpenSansSemibold" FontSize="40" FontAttributes="Bold"
                                   TextColor="{DynamicResource LimeGreen}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="♥ LIKES"
                                   FontFamily="OpenSansSemibold" FontSize="11"
                                   TextColor="{DynamicResource OnSurfaceVariant}"
                                   CharacterSpacing="1"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Achievement Badges -->
                <VerticalStackLayout IsVisible="{Binding HasUnlockedBadges}" Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" Padding="0,0,0,4">
                        <Label Grid.Column="0" Text="Achievement in evidenza" FontFamily="Lexend"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="{DynamicResource OnSurfaceVariant}" />
                        <Label Grid.Column="1" Text="{Binding AchievementSummary}"
                               FontFamily="Inter" FontSize="11"
                               TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center" />
                    </Grid>
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8"
                            BindableLayout.ItemsSource="{Binding UnlockedBadges}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{DynamicResource SurfaceContainer}"
                                            Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1"
                                            WidthRequest="50" HeightRequest="50">
                                        <Image Source="{Binding .}" WidthRequest="44" HeightRequest="44"
                                               Aspect="AspectFit"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Recent Forges -->
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*" Padding="0,0,0,8">
                        <Label Grid.Column="0" Text="Recent Forges"
                               FontFamily="OpenSansSemibold" FontSize="20" FontAttributes="Bold"
                               TextColor="{DynamicResource OnSurface}" />
                    </Grid>

                    <!-- Workout load error -->
                    <Label Text="{Binding WorkoutLoadError}"
                           IsVisible="{Binding HasWorkoutError}"
                           FontFamily="Inter" FontSize="14"
                           TextColor="{DynamicResource TextSecondary}"
                           HorizontalTextAlignment="Center" Margin="0,16" />

                    <VerticalStackLayout Spacing="16"
                        BindableLayout.ItemsSource="{Binding RecentWorkouts}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProfileWorkout">
                                <Border BackgroundColor="{DynamicResource SurfaceContainerLowest}"
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1"
                                        Padding="20">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=OpenWorkoutDetailCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="4,16,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                        <!-- Colored left border -->
                                        <Border Grid.Column="0" Grid.RowSpan="6"
                                                BackgroundColor="{Binding BorderColor}"
                                                StrokeShape="RoundRectangle 2"
                                                WidthRequest="4" VerticalOptions="Fill" />

                                        <!-- Title + Category -->
                                        <Grid Grid.Column="2" Grid.Row="0"
                                              ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout>
                                                <Label Text="{Binding Title}"
                                                       FontFamily="OpenSansSemibold" FontSize="20" FontAttributes="Bold"
                                                       TextColor="{DynamicResource OnSurface}" />
                                                <Label Text="{Binding Date}"
                                                       FontFamily="OpenSansRegular" FontSize="16"
                                                       TextColor="{DynamicResource OnSurfaceVariant}" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <!-- Stats chips -->
                                        <FlexLayout Grid.Column="2" Grid.Row="1"
                                                    Wrap="Wrap" Margin="0,12">
                                            <Border BackgroundColor="{DynamicResource SurfaceContainer}"
                                                    StrokeShape="RoundRectangle 8" Padding="12,8" Margin="0,0,8,8">
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="⏱" FontSize="14" VerticalOptions="Center" />
                                                    <Label Text="{Binding Duration}"
                                                           FontFamily="OpenSansSemibold" FontSize="14"
                                                           TextColor="{DynamicResource OnSurface}" />
                                                </HorizontalStackLayout>
                                            </Border>
                                            <Border BackgroundColor="{DynamicResource SurfaceContainer}"
                                                    StrokeShape="RoundRectangle 8" Padding="12,8" Margin="0,0,8,8">
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="♥" FontSize="14" VerticalOptions="Center" />
                                                    <Label Text="{Binding Likes}"
                                                           FontFamily="OpenSansSemibold" FontSize="14"
                                                           TextColor="{DynamicResource OnSurface}" />
                                                </HorizontalStackLayout>
                                            </Border>
                                            <Border BackgroundColor="{DynamicResource SurfaceContainer}"
                                                    StrokeShape="RoundRectangle 8" Padding="12,8" Margin="0,0,8,8">
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="🏋" FontSize="14" VerticalOptions="Center" />
                                                    <Label Text="{Binding Volume}"
                                                           FontFamily="OpenSansSemibold" FontSize="14"
                                                           TextColor="{DynamicResource OnSurface}" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </FlexLayout>

                                        <!-- Photo thumbnail -->
                                        <Border Grid.Column="2" Grid.Row="2"
                                                IsVisible="{Binding HasPhotos}"
                                                StrokeShape="RoundRectangle 8"
                                                WidthRequest="60" HeightRequest="60"
                                                Margin="0,4,0,0"
                                                BackgroundColor="{DynamicResource SurfaceContainer}">
                                            <Image Source="{Binding FirstPhoto, Converter={StaticResource WorkoutPhotoConverter}}" Aspect="AspectFill"
                                                   WidthRequest="60" HeightRequest="60" />
                                        </Border>

                                        <!-- Notes -->
                                        <Label Grid.Column="2" Grid.Row="3"
                                               Text="{Binding Notes}"
                                               IsVisible="{Binding HasNotes}"
                                               FontFamily="OpenSansRegular" FontSize="14"
                                               TextColor="{DynamicResource TextSecondary}"
                                               LineBreakMode="TailTruncation" MaxLines="2"
                                               Margin="0,6,0,0" />

                                        <!-- Separator -->
                                        <BoxView Grid.Column="2" Grid.Row="4"
                                                 HeightRequest="0.5"
                                                 Color="{DynamicResource OutlineVariant}"
                                                 Margin="0,8" />
                                        <VerticalStackLayout Grid.Column="2" Grid.Row="5" Spacing="6" Margin="0,8,0,0">
                                            <Label Text="EXERCISES"
                                                   FontFamily="OpenSansSemibold" FontSize="11"
                                                   TextColor="{DynamicResource OnSurfaceVariant}"
                                                   CharacterSpacing="0.6" />
                                            <Label Text="{Binding Exercises}"
                                                   FontFamily="OpenSansRegular" FontSize="16"
                                                   TextColor="{DynamicResource OnSurface}"
                                                   LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Edit Profile Overlay -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsEditing}"
              BackgroundColor="{DynamicResource Surface}" Padding="24">
            <ScrollView><VerticalStackLayout Spacing="16" VerticalOptions="Center" MaximumWidthRequest="400"
                                 HorizontalOptions="Center">

                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="EDIT PROFILE" FontFamily="SpaceGrotesk" FontSize="24" FontAttributes="Bold"
                           TextColor="{DynamicResource OnSurface}" HorizontalTextAlignment="Center" />
                    <Label Text="Update your bio and athlete info" FontFamily="Inter" FontSize="13"
                           TextColor="{DynamicResource OnSurfaceVariant}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Current Avatar Preview -->
                <Border BackgroundColor="{DynamicResource SurfaceContainerHigh}"
                        StrokeShape="RoundRectangle 48" WidthRequest="96" HeightRequest="96" Padding="0"
                        Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1"
                        HorizontalOptions="Center">
                    <Grid><Image Source="{Binding AvatarSource}" Aspect="AspectFill"
                           WidthRequest="96" HeightRequest="96"
                           IsVisible="{Binding HasAvatar}" />
<Label Text="{Binding AvatarInitials}" FontFamily="SpaceGrotesk" FontSize="32" FontAttributes="Bold"
                           TextColor="{DynamicResource OnSurface}"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           IsVisible="{Binding HasAvatar, Converter={StaticResource InverseBoolConverter}}" /></Grid>
                </Border>

                <!-- Name -->
                <Border BackgroundColor="{DynamicResource SurfaceContainer}" StrokeShape="RoundRectangle 12"
                        Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" Padding="16,6">
                    <Entry Text="{Binding EditName}" Placeholder="Athlete Name"
                           FontFamily="Inter" FontSize="16"
                           TextColor="{DynamicResource OnSurface}" PlaceholderColor="{DynamicResource Outline}"
                           BackgroundColor="Transparent" />
                </Border>

                <!-- Bio -->
                <Border BackgroundColor="{DynamicResource SurfaceContainer}" StrokeShape="RoundRectangle 12"
                        Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" Padding="16,6"
                        HeightRequest="120">
                    <Editor Text="{Binding EditBio}" Placeholder="Bio..."
                            FontFamily="Inter" FontSize="14"
                            TextColor="{DynamicResource OnSurface}" PlaceholderColor="{DynamicResource Outline}"
                            BackgroundColor="Transparent" AutoSize="TextChanges" />
                </Border>

                <Button Text="Cambia foto profilo" Command="{Binding ChangeAvatarCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" />
                <Label Text="Visibilità di tutti i tuoi allenamenti" FontSize="13" TextColor="{DynamicResource OnSurface}" />
                <Picker ItemsSource="{Binding VisibilityChoices}" SelectedIndex="{Binding VisibilityIndex}" TextColor="{DynamicResource OnSurface}" BackgroundColor="{DynamicResource SurfaceContainer}" />
                <Label Text="Visibilità di follower e seguiti" FontFamily="Lexend" TextColor="{DynamicResource OnSurface}" />
                <Picker ItemsSource="{Binding VisibilityChoices}" SelectedIndex="{Binding ConnectionsVisibilityIndex}" TextColor="{DynamicResource OnSurface}" BackgroundColor="{DynamicResource SurfaceContainer}" />
                <Label Text="Gli amici sono le persone con cui vi seguite a vicenda, con entrambe le richieste accettate." FontFamily="Inter" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                <Label Text="Scegli gli achievement sbloccati da mostrare" TextColor="{DynamicResource OnSurface}" />
                <CollectionView ItemsSource="{Binding BadgeChoices}" HeightRequest="180" SelectionMode="None">
                    <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="6" /></CollectionView.ItemsLayout>
                    <CollectionView.EmptyView><Label Text="Completa un allenamento per sbloccare i primi achievement." TextColor="{DynamicResource TextSecondary}" /></CollectionView.EmptyView>
                    <CollectionView.ItemTemplate><DataTemplate x:DataType="vm:BadgeChoice">
                        <Grid ColumnDefinitions="44,*,32" ColumnSpacing="8" Padding="4">
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference profilePage}, Path=BindingContext.ToggleBadgeCommand}" CommandParameter="{Binding .}" /></Grid.GestureRecognizers>
                            <Image Source="{Binding Icon}" HeightRequest="40" WidthRequest="40" />
                            <Label Grid.Column="1" Text="{Binding Name}" TextColor="{DynamicResource OnSurface}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="✓" IsVisible="{Binding IsSelected}" TextColor="{DynamicResource Primary}" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate></CollectionView.ItemTemplate>
                </CollectionView>
                <!-- Save -->
                <Button Text="SAVE CHANGES" FontFamily="Lexend" FontSize="14" FontAttributes="Bold"
                        CharacterSpacing="1"
                        BackgroundColor="{DynamicResource Primary}" TextColor="{DynamicResource OnPrimary}"
                        HeightRequest="52" CornerRadius="12"
                        Command="{Binding SaveProfileCommand}" />

                <!-- Cancel -->
                <Button Text="Cancel" FontFamily="Inter" FontSize="14"
                        BackgroundColor="Transparent" TextColor="{DynamicResource OnSurfaceVariant}"
                        Command="{Binding CancelEditCommand}" />

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   HorizontalOptions="Center" Color="{DynamicResource Primary}" />

                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                       FontFamily="Inter" FontSize="13" TextColor="{DynamicResource Error}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout></ScrollView>
        </Grid>
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsConnectionsVisible}" BackgroundColor="{DynamicResource Surface}" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">
            <Grid ColumnDefinitions="48,*,48" Padding="24,16" ColumnSpacing="12">
                <Button Text="←" Command="{Binding CloseConnectionsCommand}" CornerRadius="24" HeightRequest="48" Padding="0"
                        BackgroundColor="{DynamicResource SurfaceContainer}" TextColor="{DynamicResource OnSurface}" FontSize="24" />
                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                    <Label Text="{Binding ConnectionsTitle}" FontFamily="Lexend" FontAttributes="Bold" FontSize="24" TextColor="{DynamicResource OnSurface}" />
                    <Label Text="{Binding Username}" FontFamily="Inter" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                </VerticalStackLayout>
            </Grid>
            <Label Grid.Row="1" Margin="24,0" Text="Gli amici sono le persone che ricambiano il follow. Il cerchio blu apre l’ultimo allenamento pubblico."
                   FontFamily="Inter" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
            <VerticalStackLayout Grid.Row="2" Margin="24,0" Spacing="8">
                <ActivityIndicator IsVisible="{Binding IsConnectionsLoading}" IsRunning="{Binding IsConnectionsLoading}" Color="{DynamicResource Primary}" />
                <Label Text="{Binding ConnectionsError}" FontFamily="Inter" FontSize="13" TextColor="{DynamicResource Error}" />
            </VerticalStackLayout>
            <CollectionView Grid.Row="3" Margin="20,0,20,24" ItemsSource="{Binding Connections}" SelectionMode="None">
                <CollectionView.EmptyView><Label Text="{Binding ConnectionsMessage}" Margin="24" FontFamily="Inter" HorizontalTextAlignment="Center" TextColor="{DynamicResource TextSecondary}" /></CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:UserSearchResult">
                        <Border Margin="0,0,0,12" Padding="14" StrokeShape="RoundRectangle 22" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="0.5" BackgroundColor="{DynamicResource SurfaceContainer}">
                            <Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="60" HeightRequest="60" Padding="3" StrokeShape="RoundRectangle 30" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="2" VerticalOptions="Center">
                                    <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding HasPublicWorkout}" Value="True"><Setter Property="Stroke" Value="{DynamicResource ElectricBlue}" /></DataTrigger></Border.Triggers>
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference profilePage}, Path=BindingContext.OpenConnectionStoryCommand}" CommandParameter="{Binding .}" /></Border.GestureRecognizers>
                                    <Border StrokeShape="RoundRectangle 26" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceContainerHigh}" Padding="0">
                                        <Grid>
                                            <Image Source="{Binding AvatarSource}" Aspect="AspectFill" IsVisible="{Binding HasAvatar}" />
                                            <Label Text="{Binding Initial}" IsVisible="{Binding HasAvatar, Converter={StaticResource InverseBoolConverter}}" FontFamily="Lexend" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{DynamicResource OnSurface}" />
                                        </Grid>
                                    </Border>
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Name}" FontFamily="Lexend" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation" VerticalOptions="Center" TextColor="{DynamicResource OnSurface}">
                                    <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference profilePage}, Path=BindingContext.OpenUserProfileCommand}" CommandParameter="{Binding .}" /></Label.GestureRecognizers>
                                </Label>
                                <Button Grid.Column="2" Text="{Binding FollowLabel}" IsVisible="{Binding CanFollow}" Command="{Binding Source={x:Reference profilePage}, Path=BindingContext.FollowConnectionCommand}" CommandParameter="{Binding .}"
                                        FontFamily="Inter" FontSize="11" FontAttributes="Bold" CornerRadius="14" Padding="12,0" HeightRequest="40" VerticalOptions="Center" BackgroundColor="{DynamicResource Primary}" TextColor="{DynamicResource OnPrimary}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsUnfollowConfirmationVisible}" BackgroundColor="#99000000" Padding="24">
            <Border StrokeShape="RoundRectangle 28" Padding="24" BackgroundColor="{DynamicResource SurfaceContainer}" Stroke="{DynamicResource OutlineVariant}" VerticalOptions="Center" MaximumWidthRequest="420" HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="18">
                    <Label Text="Smettere di seguire?" FontFamily="Lexend" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                    <Label Text="{Binding UnfollowName}" FontFamily="Lexend" FontSize="16" TextColor="{DynamicResource Primary}" />
                    <Label Text="Confermando smetterai di seguire questo account." FontFamily="Inter" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                    <Button Text="Smetti di seguire" Command="{Binding ConfirmUnfollowCommand}" CornerRadius="16" HeightRequest="48" FontFamily="Lexend" FontAttributes="Bold" BackgroundColor="{DynamicResource Primary}" TextColor="{DynamicResource OnPrimary}" />
                    <Button Text="Annulla" Command="{Binding CancelUnfollowCommand}" CornerRadius="16" HeightRequest="44" FontFamily="Inter" BackgroundColor="{DynamicResource SurfaceContainerHigh}" TextColor="{DynamicResource OnSurface}" />
                    <ActivityIndicator IsVisible="{Binding IsFollowBusy}" IsRunning="{Binding IsFollowBusy}" Color="{DynamicResource Primary}" />
                    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{DynamicResource Error}" FontFamily="Inter" FontSize="12" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
