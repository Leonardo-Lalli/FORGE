FROM alpine:3.22
ARG PB_VERSION
ARG TARGETARCH
RUN apk add --no-cache ca-certificates wget unzip curl jq \
    && case "$PB_VERSION" in ""|*[!0-9.]*) echo "Set a numeric PocketBase release version" >&2; exit 1;; esac \
    && case "$TARGETARCH" in amd64|arm64) ;; *) echo "Unsupported architecture" >&2; exit 1;; esac \
    && wget -q "https://github.com/pocketbase/pocketbase/releases/download/v${PB_VERSION}/pocketbase_${PB_VERSION}_linux_${TARGETARCH}.zip" -O /tmp/pb.zip \
    && unzip /tmp/pb.zip pocketbase -d /usr/local/bin \
    && chmod 755 /usr/local/bin/pocketbase && rm /tmp/pb.zip
COPY entrypoint.sh /usr/local/bin/forge-entrypoint
RUN sed -i 's/\r$//' /usr/local/bin/forge-entrypoint && chmod 755 /usr/local/bin/forge-entrypoint
EXPOSE 8090
ENTRYPOINT ["/usr/local/bin/forge-entrypoint"]
CMD ["serve", "--http=0.0.0.0:8090", "--dir=/pb_data", "--hooksDir=/pb_hooks", "--migrationsDir=/pb_migrations"]
