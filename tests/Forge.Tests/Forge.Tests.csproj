<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Forge.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Microsoft.Maui.Controls" />
    <Using Include="Forge.Converters" />
    <Using Include="Forge.Models" />
    <Using Include="Forge.Models.Dto" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="sqlite-net-base" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Forge\Models\*.cs" Link="Shared\Models\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Forge\Models\Dto\*.cs" Link="Shared\Models\Dto\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Forge\Converters\*.cs" Link="Shared\Converters\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Forge\Messages\*.cs" Link="Shared\Messages\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Forge\Services\PreviousPerformance.cs" Link="Shared/Services/PreviousPerformance.cs" />
    <Compile Include="..\..\src\Forge\Services\VolumeChart.cs" Link="Shared/Services/VolumeChart.cs" />
    <Compile Include="..\..\src\Forge\Services\AchievementEvaluator.cs" Link="Shared\Services\AchievementEvaluator.cs" />
    <Compile Include="..\..\src\Forge\Services\DatabaseService.cs" Link="Shared\Services\DatabaseService.cs" />
    <Compile Include="..\..\src\Forge\Services\CertificatePinningHandler.cs" Link="Shared\Services\CertificatePinningHandler.cs" />
    <Compile Include="..\..\src\Forge\Services\WorkoutSyncPayload.cs" Link="Shared\Services\WorkoutSyncPayload.cs" />
    <Compile Include="..\..\src\Forge\Services\PocketBaseService.Profiles.cs" Link="Shared/Services/PocketBaseService.Profiles.cs" />
    <Compile Include="..\..\src\Forge\Services\PlanService.cs" Link="Shared/Services/PlanService.cs" />
    <Compile Include="..\..\src\Forge\Services\PocketBaseService.cs" Link="Shared\Services\PocketBaseService.cs" />
    <Compile Include="..\..\src\Forge\Services\ServerAddress.cs" Link="Shared\Services\ServerAddress.cs" />
    <Compile Include="..\..\src\Forge\Services\BuildSecrets.cs" Link="Shared\Services\BuildSecrets.cs" />
    <Compile Include="..\..\src\Forge\Services\AchievementService.cs" Link="Shared\Services\AchievementService.cs" />
    <Compile Include="..\..\src\Forge\ViewModels\AchievementsViewModel.cs" Link="Shared\ViewModels\AchievementsViewModel.cs" />
    <Compile Include="..\..\src\Forge\ViewModels\BaseViewModel.cs" Link="Shared\ViewModels\BaseViewModel.cs" />
  </ItemGroup>

</Project>
